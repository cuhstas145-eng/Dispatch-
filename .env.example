# CargoSync web app
# Local test uses HTTP and requires 0. For public HTTPS deployment set 1.
CARGOSYNC_SECURE_COOKIES=0
CARGOSYNC_SESSION_DAYS=7

# Public deployment. Point DNS to this server before enabling the https profile.
CARGOSYNC_DOMAIN=cargosync.example.com

# First-admin bootstrap (only the first startup uses these; use a unique password >=16 chars).
CARGOSYNC_BOOTSTRAP_ADMIN_NAME=Workspace Admin
CARGOSYNC_BOOTSTRAP_ADMIN_USERNAME=admin
CARGOSYNC_BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-unique-long-password

# Optional Telegram bot. Set a real token and public HTTPS URL after deployment.
TELEGRAM_BOT_TOKEN=
CARGOSYNC_WEBAPP_URL=https://cargosync.example.com/?view=schedule