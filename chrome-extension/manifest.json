{
  "manifest_version": 3,
  "name": "CargoSync Route Planner",
  "version": "1.2.0",
  "description": "A functional route planner and RPM calculator in Chrome's side panel.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*",
    "https://*.tile.openstreetmap.org/*",
    "https://unpkg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open CargoSync Route Planner"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
