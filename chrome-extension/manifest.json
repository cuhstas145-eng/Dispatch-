{
  "manifest_version": 3,
  "name": "CargoSync Route Planner",
  "version": "1.1.0",
  "description": "A working route planner and RPM calculator in Chrome's side panel.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "action": {
    "default_title": "CargoSync Route Planner",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
